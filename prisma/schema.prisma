// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroContent {
  id                Int      @id @default(autoincrement())
  badge             String
  titleLine1        String
  titleLine2        String
  description       String
  primaryCtaLabel   String
  secondaryCtaLabel String
  clients           Json?
  images            Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Article {
  id             String   @id
  title          String
  excerpt        String
  content        Json?
  date           DateTime @default(now())
  image          String
  category       String
  objectPosition String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AboutContent {
  id          Int      @id @default(autoincrement())
  description String   @db.LongText
  highlights  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServicesContent {
  id             Int      @id @default(autoincrement())
  pillLabel      String
  headingLine1   String
  headingLine2   String
  ctaLabel       String
  detailCtaLabel String
  services       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GalleryContent {
  id           Int      @id @default(autoincrement())
  sideLabel    String
  headingLine1 String
  headingLine2 String
  items        Int
  itemsData    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VideoShowcaseContent {
  id          Int      @id @default(autoincrement())
  pillLabel   String
  heading     String
  description String   @db.LongText
  categories  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SectionEditLimit {
  id        String   @id // Contoh: "about", "services", "gallery", "videoShowcase", "articles"
  editCount Int      @default(0)
  updatedAt DateTime @updatedAt
}
